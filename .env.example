# توكن البوت من @BotFather
BOT_TOKEN=123456:ABCDEF...

# احصل عليهم من my.telegram.org (Login -> API Development Tools)
TG_API_ID=123456
TG_API_HASH=abcdef1234567890abcdef1234567890

# رابط الخدمة العلني على Render (يظهر بعد أول نشر، مثال: https://xxx.onrender.com)
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# اختياري - كل چم ثانية يسوي بينك ذاتي (افتراضي 600 = 10 دقايق)
PING_INTERVAL=600

# اختياري - آيدي تليگرام رقمي حقك، يوصلك عليه إشعار كل مستخدم جديد (احصل عليه من @userinfobot)
# نفس الآيدي يستخدم لفتح لوحة تحكم الأدمن بأمر /admin
ADMIN_CHAT_ID=123456789

# اختياري - آيدي قناة/مجموعة رقمي (يبدأ بـ -100) تروح عليها إشعارات الشراء والاسترجاع وتنبيه رصيد TikHub.
# لازم البوت يكون أدمن بالقناة. اذا تركته فاضي تروح الإشعارات لـ ADMIN_CHAT_ID بالخاص.
# جرّب من /admin ← 💰 الأرصدة والدفع ← 📢 قناة الإشعارات + تجربة
NOTIFY_CHANNEL_ID=-1001234567890

# رابط اتصال MongoDB (يفعل: رسائل قابلة للتعديل، سجل روابط، حظر، توقيف منصات، إحصائيات)
# بدونه البوت يشتغل عادي بالرسائل الافتراضية بس بدون هذي الميزات
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=x_douyin_bot

# اختياري - أقصى حجم ملف بالميكابايت يسمح البوت يرسله (افتراضي 250)
MAX_FILE_SIZE_MB=250

# اختياري - الحجم اللي فوقه يعتبر تحميل "ثقيل" (افتراضي 150، يفعّل نظام الطابور تلقائياً)
HEAVY_FILE_THRESHOLD_MB=150

# اختياري - مفتاح TikHub API (يفعل استهلاك TikHub بالإحصائيات، وتحميل ويشات)
TIKHUB_API_KEY=

# اختياري - رابط خدمة فك تشفير فيديوهات ويشات (خدمة Render ثانية منفصلة)
# انشرها من Docker Hub image: docker.io/evil0ctal/wechat-decrypt-api:latest
WECHAT_DECRYPT_API_URL=https://wechat-decrypt-api.onrender.com

# اختياري - رابط خدمتك على Render (يظهر كرابط سريع بالإحصائيات لمراجعة استهلاك RAM/المساحة)
RENDER_DASHBOARD_URL=https://dashboard.render.com/web/srv-xxxxxxxx

# اختياري - كوكيز حساب X حقيقي مشفرة base64 (تحل "Video is unavailable" ببعض الروابط)
X_COOKIES_DATA=

# اختياري - كوكيز دويين مشفرة base64 (تحل "Fresh cookies are needed")
DOUYIN_COOKIES_DATA=

# اختياري - كوكيز RedNote/Xiaohongshu مشفرة base64 (قد تحتاجها بعض الروابط)
REDNOTE_COOKIES_DATA=

# توكن البوت من @BotFather
BOT_TOKEN=123456:ABCDEF...

# احصل عليهم من my.telegram.org (Login -> API Development Tools)
TG_API_ID=123456
TG_API_HASH=abcdef1234567890abcdef1234567890

# رابط الخدمة العلني على Render (يظهر بعد أول نشر، مثال: https://xxx.onrender.com)
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# اختياري - كل چم ثانية يسوي بينك ذاتي (افتراضي 600 = 10 دقايق)
PING_INTERVAL=600
